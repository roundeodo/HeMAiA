# Two-slot production-path test for the 2048 -> 1024 -> 2048 individual expert.
{
    array_shape: 0
    total_tokens: 11
    hidden_size: 2048
    intermediate_size: 1024
    // Equal 256 KiB aggregate payloads for one DMA/VC pipeline phase.
    weight_chunk_cols: 128
    s1_weight_chunk_cols: 128
    s3_weight_chunk_cols: 256
    s1_block_count: 8
    s3_block_count: 4
    num_indiv_experts: 8
    // All logical experts in this focused workload reuse one physical backing.
    num_indiv_weight_backings: 1
    num_shared_experts: 2
    top_k: 2
    addNonZeroC: 0
    addZeroC: 1
    accumPrevC: 0
}
