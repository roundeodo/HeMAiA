#
# Dual-VersaCore multi_cluster_MoE workload parameters
#
# 这是模型和 workload 尺寸的唯一编辑入口。不要修改生成的
# multi_cluster_MoE_data.h 或 offload_bingo_hw.h。
#
# moe_layout.py::derive_mixed_workload_params() 同时派生 shared 的旧 L1.5
# layout 和 individual 的 bank layout；datagen 与 main_bingo.py 都调用该函数。
#
# 注意：这里会联动更新数据、DFG、DMA/GEMM 参数和内存布局；RTL scheduler
# 内部的归一化代价常数不由本文件生成。改变模型维度后功能 ABI 仍同步，但若
# 需要最优调度周期，还应针对新维度重新标定硬件代价常数。
#
# 当前模型：8 tokens，2048 -> 1024 -> 2048，8 个 individual experts，Top-2。

{
    // Router/shared 静态计算固定使用 S0；individual 运行时仍可由 scheduler
    // 在 S0/S1/S2 中选择。这里不是模型 hidden size，而是静态节点形状。
    array_shape: 0

    // ------------------------------------------------------------------
    // 模型级参数
    // 这里只填写逻辑模型维度。Router/shared/individual 的 M/N/K tile 分解
    // 全部由 moe_layout.py 根据所选硬件 S0 形状自动推导。
    //
    // 约束：
    //   total_tokens      必须为正数且为 meshRow(8) 的整数倍；这是旧 shared
    //                     L1.5 kernel 的约束（Router 本身仍支持尾行补零）
    //   hidden_size/2 和 intermediate_size 必须能被 weight_chunk_cols 整除
    //   num_indiv_experts 必须能被 2*meshCol(8) 整除
    // ------------------------------------------------------------------
    total_tokens: 8
    hidden_size: 2048
    intermediate_size: 1024
    // 一个 DFG block 对应一个物理 weight chunk。当前每个 Mode0 block 和
    // 每个 Mode1/VC block 都覆盖 128 columns；block 数由模型尺寸自动推导。
    // chunk 必须是 16 columns 的整数倍，以保留 common-16 panel ABI。
    weight_chunk_cols: 128
    num_indiv_experts: 8
    // 纯 HW RouterSched 专门实现 Top-2；生成器会拒绝其他取值。
    // 纯 SW 对照路径仍保留运行时 top_k ABI。
    top_k: 2
    // C0/C1 各固定执行一个 shared expert，因此当前 DFG 必须为 2。
    num_shared_experts: 2

    // 静态 DFG slot 数由 num_indiv_experts 自动派生。RTL 可以把同一 expert
    // 拆成 C2/C3 各一条 task，但每个 cluster 对该 expert 最多收到一条，
    // 因此 num_indiv_experts 是每个 cluster 的严格 slot 上界。

    // ------------------------------------------------------------------
    // 固定硬件形状由 --hwcfg 读取。当前 workload 要求
    // S0=(meshRow=8,tileSize=8,meshCol=4)，down_meshCol 自动取 2*meshCol。
    //
    // Individual 的 L3 token row 是连续的 hidden_size*2 bytes，不带 padding；
    // shared 另有一份旧 L1.5 输入，每行仍保留 32B padding。
    // L3->L1 gather 对每个有效 token 发一个 16B x hidden_size/8 的 2D
    // descriptor，目的 row stride 固定为 512B。local token t 的 lane=t%8，
    // 因而使用 banks 2*lane..2*lane+1；page=t/8 选择更深的 TCDM row 区域。
    // 一个 scheduler task 始终一次 gather 完整 token slice，不拆成多个 wave。
    // ------------------------------------------------------------------
    // VersaCore accumulation mode。当前 MoE 路径从零开始累加，不读取旧 C。
    addNonZeroC: 0
    addZeroC: 1
    accumPrevC: 0
}
